---
import Base from "../layouts/Base.astro";

import { areas as catalogo } from "../data/informes";

const areas = catalogo.map((area) => ({
	title: area.titulo,
	href: `/${area.id}`,
	tone: area.tone,
}));
---

<Base title="Obras Públicas">
	<main class="page">
		<div class="intro">
			<h1>Obras Públicas</h1>
			<span class="title-mark" aria-hidden="true"></span>
		</div>
		<nav aria-label="Áreas de obras públicas">
			{
				areas.map((area) => (
					<a class={`area ${area.tone}`} href={area.href}>
						<span class="symbol" aria-hidden="true">
							{area.tone === "viales" && (
								<svg viewBox="0 0 24 24">
									<path d="M8 3h8l5 18H3z" />
								</svg>
							)}
							{area.tone === "alumbrado" && (
								<svg viewBox="0 0 24 24">
									<path d="M9 21h6v-2h-6zm.2-3.2h5.6v-1.2A6.2 6.2 0 1 0 9.2 16.6z" />
								</svg>
							)}
							{area.tone === "parques" && (
								<svg viewBox="0 0 24 24">
									<path d="M5.2 18.6C6 11 11.2 6 19.4 4.6 17.6 13 12.4 18.2 5.2 18.6z" />
								</svg>
							)}
							{area.tone === "civiles" && (
								<svg viewBox="0 0 24 24">
									<path d="M4 20.5V10L12 3.5 20 10v10.5z" />
								</svg>
							)}
						</span>
						<span class="label">{area.title}</span>
					</a>
				))
			}
		</nav>
	</main>
</Base>

<style>
	.intro {
		margin-bottom: 1.75rem;
		text-align: center;
	}

	.intro h1 {
		margin: 0;
	}

	.title-mark {
		display: block;
		width: 6rem;
		height: 0.25rem;
		margin: 1rem auto 0;
		border-radius: 999px;
		background: var(--primary);
	}

	nav {
		display: grid;
		gap: 0.9rem;
	}

	.area {
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		min-height: 5.5rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #fff;
		text-decoration: none;
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.2;
		color: var(--ink);
		box-shadow: var(--shadow);
	}

	.symbol {
		display: grid;
		flex: 0 0 3.25rem;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 12px;
		background: var(--soft);
		color: var(--primary);
	}

	.symbol svg {
		width: 2.35rem;
		height: 2.35rem;
		fill: currentColor;
	}

	.label {
		min-width: 0;
	}

	.area:focus-visible {
		outline: 3px solid var(--forest);
		outline-offset: 3px;
	}

	@media (min-width: 48rem) {
		.intro {
			margin-bottom: 2.5rem;
		}

		nav {
			gap: 1.1rem;
		}

		.area {
			gap: 1.25rem;
			min-height: 6.5rem;
			padding: 1.25rem 1.35rem;
			font-size: 1.35rem;
		}

		.symbol {
			flex-basis: 3.75rem;
			width: 3.75rem;
			height: 3.75rem;
		}

		.symbol svg {
			width: 2.95rem;
			height: 2.95rem;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.area {
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

		.area:hover {
			transform: scale(1.02);
			box-shadow: 0 16px 32px rgb(0 0 0 / 14%);
		}
	}
</style>
