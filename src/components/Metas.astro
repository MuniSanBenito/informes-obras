---
import type { FilaCarga, MetaItem } from "../data/metas";

const { metas } = Astro.props as { metas: MetaItem[] };

function filasDe(item: MetaItem): FilaCarga[] {
	if (item.filas?.length) return item.filas;
	return [
		{
			id: item.codigo,
			etiqueta: item.unidad ? `Valor (${item.unidad})` : "Valor",
			unidad: item.unidad,
			hoja: item.hoja,
			fila: item.fila,
		},
	];
}
---

<section class="metas" aria-labelledby="metas-titulo">
	<h2 id="metas-titulo">Metas</h2>
	<ol class="carril">
		{
			metas.map((item) => {
				const filas = filasDe(item);
				const varias = filas.length > 1;
				return (
					<li>
						<div class="ficha">
							<p class="codigo">{item.codigo}</p>
							<p class="texto">{item.texto}</p>
							{item.meta && <p class="objetivo">{item.meta}</p>}
							{item.detalles?.map((detalle) => <p class="detalle">{detalle}</p>)}
						</div>
						{filas.map((fila) => (
							<div
								class:list={["indicador", { varias }]}
								data-id={fila.id}
								data-hoja={fila.hoja}
								data-fila={fila.fila}
								data-unidad={fila.unidad ?? ""}
							>
								{varias && <p class="etiqueta">{fila.etiqueta}</p>}
								{fila.nota && <p class="detalle">{fila.nota}</p>}
								<form>
									<label>
										{varias ? (fila.unidad ? `Valor (${fila.unidad})` : "Valor") : fila.etiqueta}
										<input name="valor" type="number" inputmode="decimal" min="0" step="any" required />
									</label>
									<button class="agregar" type="submit">Agregar</button>
								</form>
								<ul class="cargas"></ul>
								<p class="suma" hidden></p>
								<p class="planilla-estado" role="status" hidden></p>
							</div>
						))}
					</li>
				);
			})
		}
	</ol>
	<template id="tpl-valor-meta">
		<li class="carga">
			<span class="carga-valor"></span>
			<button class="quitar" type="button">Quitar</button>
		</li>
	</template>
</section>

<script>
	import { guardarMes, leerMes } from "../lib/cargas";
	import { columnaMes, enviarPlanilla, PLANILLA_SCRIPT } from "../lib/planilla";
	import { leerPeriodo, nombrePeriodo } from "../lib/periodo";

	const carril = document.querySelector(".carril");
	const template = document.querySelector("#tpl-valor-meta");
	const numero = new Intl.NumberFormat("es-AR", { maximumFractionDigits: 2 });

	let periodo = leerPeriodo();
	let cargas = leerMes(periodo);
	let cola = Promise.resolve();

	function formato(valor, unidad) {
		const texto = numero.format(valor);
		return unidad ? `${texto} ${unidad}` : texto;
	}

	function totalDe(id) {
		return (cargas[id] ?? []).reduce((acumulado, item) => acumulado + item.valor, 0);
	}

	function mostrarEstado(indicador, texto) {
		const estado = indicador.querySelector(".planilla-estado");
		estado.hidden = false;
		estado.textContent = texto;
	}

	function limpiarEstado(indicador) {
		const estado = indicador.querySelector(".planilla-estado");
		estado.hidden = true;
		estado.textContent = "";
	}

	function publicarSuma(indicador) {
		const id = indicador.dataset.id;
		const hoja = indicador.dataset.hoja ?? "";
		const fila = Number(indicador.dataset.fila);
		const valor = totalDe(id);
		const envio = { anio: periodo.anio, mes: periodo.mes, hoja, fila, valor };
		const nombre = nombrePeriodo(envio);

		if (columnaMes(hoja, envio.anio, envio.mes) == null) {
			mostrarEstado(indicador, `La planilla no tiene ${nombre}.`);
			return;
		}
		if (!PLANILLA_SCRIPT) {
			mostrarEstado(indicador, "La suma quedó en este dispositivo. Falta conectar la planilla.");
			return;
		}

		mostrarEstado(indicador, "Sumando a la planilla…");
		cola = cola.then(async () => {
			try {
				await enviarPlanilla(envio.anio, envio.mes, [{ hoja, fila, valor }]);
				if (periodo.anio === envio.anio && periodo.mes === envio.mes) {
					mostrarEstado(indicador, "Sumada a la planilla.");
				}
			} catch {
				if (periodo.anio === envio.anio && periodo.mes === envio.mes) {
					mostrarEstado(indicador, "No se pudo sumar a la planilla.");
				}
			}
		});
	}

	function renderIndicador(indicador) {
		const id = indicador.dataset.id;
		const unidad = indicador.dataset.unidad ?? "";
		const lista = indicador.querySelector(".cargas");
		const suma = indicador.querySelector(".suma");
		const items = cargas[id] ?? [];
		lista.replaceChildren();
		for (const item of items) {
			const node = template.content.firstElementChild.cloneNode(true);
			node.querySelector(".carga-valor").textContent = formato(item.valor, unidad);
			const quitar = node.querySelector(".quitar");
			quitar.setAttribute("aria-label", `Quitar ${formato(item.valor, unidad)}`);
			quitar.addEventListener("click", () => {
				cargas[id] = (cargas[id] ?? []).filter((carga) => carga.id !== item.id);
				if (cargas[id].length === 0) delete cargas[id];
				guardarMes(periodo, cargas);
				renderIndicador(indicador);
				publicarSuma(indicador);
			});
			lista.append(node);
		}
		const total = totalDe(id);
		suma.hidden = items.length === 0;
		suma.textContent = `Suma: ${formato(total, unidad)}`;
	}

	for (const indicador of carril.querySelectorAll(".indicador")) {
		renderIndicador(indicador);
		indicador.querySelector("form").addEventListener("submit", (event) => {
			event.preventDefault();
			const id = indicador.dataset.id;
			const valor = Number(new FormData(event.currentTarget).get("valor"));
			if (!Number.isFinite(valor) || valor < 0) return;
			cargas[id] = [...(cargas[id] ?? []), { id: crypto.randomUUID(), valor }];
			guardarMes(periodo, cargas);
			event.currentTarget.reset();
			renderIndicador(indicador);
			publicarSuma(indicador);
		});
	}

	window.addEventListener("informe-periodo", () => {
		periodo = leerPeriodo();
		cargas = leerMes(periodo);
		for (const indicador of carril.querySelectorAll(".indicador")) {
			limpiarEstado(indicador);
			renderIndicador(indicador);
		}
	});
</script>

<style>
	.metas {
		margin-bottom: 1.5rem;
	}

	.metas h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
		line-height: 1.2;
	}

	.carril {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.carril > li {
		display: grid;
		gap: 0.75rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #fff;
		box-shadow: var(--shadow);
	}

	.codigo,
	.texto,
	.objetivo,
	.detalle,
	.etiqueta,
	.suma,
	.planilla-estado {
		margin: 0;
	}

	.codigo {
		color: var(--accent, var(--forest));
		font-size: 0.95rem;
		font-weight: 700;
	}

	.texto {
		margin-top: 0.2rem;
		font-size: 1rem;
		line-height: 1.35;
	}

	.objetivo,
	.detalle {
		margin-top: 0.45rem;
		font-size: 0.95rem;
	}

	.objetivo,
	.etiqueta {
		font-weight: 650;
	}

	.indicador {
		display: grid;
		gap: 0.75rem;
	}

	.indicador.varias + .indicador.varias {
		padding-top: 0.75rem;
		border-top: 1px solid var(--line);
	}

	form {
		display: grid;
		gap: 0.75rem;
	}

	label {
		display: grid;
		gap: 0.35rem;
		font-size: 1rem;
		font-weight: 650;
	}

	input {
		width: 100%;
		min-height: 3rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #fff;
		color: inherit;
		font: inherit;
		font-weight: 450;
	}

	input:focus-visible,
	button:focus-visible {
		outline: 3px solid var(--forest);
		outline-offset: 3px;
	}

	.agregar,
	.quitar {
		min-height: 3rem;
		border-radius: 999px;
		font: inherit;
		font-weight: 700;
	}

	.agregar {
		border: 0;
		background: var(--primary);
		color: var(--ink);
	}

	.cargas {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.carga {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		justify-content: space-between;
	}

	.quitar {
		padding: 0 0.9rem;
		border: 1px solid var(--primary);
		background: #fff;
		color: var(--ink);
	}

	.suma,
	.planilla-estado {
		font-weight: 650;
	}

	@media (min-width: 48rem) {
		.metas h2 {
			margin-bottom: 1rem;
			font-size: 1.5rem;
		}
	}
</style>
