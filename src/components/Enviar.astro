---
import { PLANILLA_URL } from "../lib/planilla";
---

<div class="envio">
	<button class="enviar" type="button">Enviar a la planilla</button>
	<p class="envio-estado" role="status" hidden></p>
	<a class="planilla" href={PLANILLA_URL} target="_blank" rel="noopener noreferrer">Abrir planilla</a>
</div>

<script>
	import { leerMes } from "../lib/cargas";
	import { columnaMes, enviarPlanilla, PLANILLA_SCRIPT } from "../lib/planilla";
	import { leerPeriodo, nombrePeriodo } from "../lib/periodo";

	const button = document.querySelector(".enviar");
	const status = document.querySelector(".envio-estado");

	function mostrar(texto) {
		status.textContent = texto;
		status.hidden = false;
	}

	function titulo() {
		if (button instanceof HTMLButtonElement) {
			button.textContent = `Enviar ${nombrePeriodo(leerPeriodo())}`;
		}
	}

	titulo();
	window.addEventListener("informe-periodo", titulo);

	button?.addEventListener("click", async () => {
		if (!(button instanceof HTMLButtonElement)) return;
		const periodo = leerPeriodo();
		const nombre = nombrePeriodo(periodo);
		const mes = leerMes(periodo);
		const paraEnviar = [];
		let sinColumna = 0;

		for (const indicador of document.querySelectorAll(".indicador")) {
			const id = indicador.dataset.id ?? "";
			const hoja = indicador.dataset.hoja ?? "";
			const fila = Number(indicador.dataset.fila);
			const items = mes[id] ?? [];
			if (!id || items.length === 0) continue;
			const valor = items.reduce((acumulado, item) => acumulado + item.valor, 0);
			if (columnaMes(hoja, periodo.anio, periodo.mes) == null) {
				sinColumna += 1;
				continue;
			}
			paraEnviar.push({ hoja, fila, valor });
		}

		if (paraEnviar.length === 0 && sinColumna === 0) {
			mostrar(`Cargá al menos un valor de ${nombre}.`);
			return;
		}
		if (paraEnviar.length === 0) {
			mostrar(`La planilla todavía no tiene una columna para ${nombre}.`);
			return;
		}
		if (!PLANILLA_SCRIPT) {
			const aviso =
				sinColumna > 0 ? ` ${sinColumna} metas no tienen columna para ese año.` : "";
			mostrar(`La suma de ${nombre} quedó guardada en este dispositivo.${aviso} Todavía no se escribió en la planilla.`);
			return;
		}

		button.disabled = true;
		try {
			await enviarPlanilla(periodo.anio, periodo.mes, paraEnviar);
			const aviso = sinColumna > 0 ? ` ${sinColumna} metas no tienen columna para ese año.` : "";
			mostrar(`Se escribió la suma de ${nombre} en la planilla.${aviso}`);
		} catch {
			mostrar(`No se pudo enviar ${nombre}. Quedó guardado en este dispositivo.`);
		} finally {
			button.disabled = false;
		}
	});
</script>

<style>
	.envio {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.enviar,
	.planilla {
		min-height: 3rem;
	}

	.enviar {
		width: 100%;
		border: 0;
		border-radius: 999px;
		background: var(--primary);
		color: var(--ink);
		font: inherit;
		font-weight: 700;
	}

	.enviar:disabled {
		opacity: 0.7;
	}

	.enviar:focus-visible,
	.planilla:focus-visible {
		outline: 3px solid var(--forest);
		outline-offset: 3px;
	}

	.envio-estado {
		margin: 0;
		font-weight: 650;
	}

	.planilla {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--accent, var(--forest));
		font-weight: 700;
		text-decoration: none;
	}
</style>
